# ==============================================================================
# KONFIGURASI SISTEM AI MONITORING K3 - IMOU ELECTRICAL ROOM
# ==============================================================================

# 1. SUMBER VIDEO (Webcam Laptop = 0, Atau RTSP Imou Cruiser)
# Contoh RTSP Imou: rtsp://admin:SAFETY_CODE@192.168.1.108:554/cam/realmonitor?channel=1&subtype=1
IMOU_RTSP_URL=0
CAMERA_NAME=Imou Electrical Room

# 2. SERVER WEB DASHBOARD
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 3. AI PERSON TRACKING & POSE ESTIMATION (YOLO11)
YOLO_MODEL=yolo11n-pose.pt
YOLO_CONFIDENCE=0.35
YOLO_IOU=0.45
YOLO_IMGSZ=640
YOLO_DEVICE=cpu
TRACKER_CONFIG=bytetrack.yaml

# 4. PPE COMPLIANCE MODELS (Helm & Rompi K3)
PPE_MODEL=models/ppe_full.pt
PPE_CONFIDENCE=0.30
PPE_HELMET_OK_CONFIDENCE=0.50
PPE_HELMET_MISSING_CONFIDENCE=0.45
PPE_VEST_OK_CONFIDENCE=0.40
PPE_VEST_MISSING_CONFIDENCE=0.45

# 5. DETEKSI MEROKOK & DETEKSI PINGSAN/JATUH
SMOKING_DETECTION_ENABLED=1
SMOKING_DEBOUNCE_SECONDS=2.5
FALL_DETECTION_ENABLED=1
FALL_DEBOUNCE_SECONDS=4.0

# 6. PENGENALAN WAJAH (OpenCV SFace & YuNet)
FACE_RECOGNITION_ENABLED=1
FACE_MATCH_THRESHOLD=0.363

# 7. ALARM SUARA K3
VOICE_ALARM_ENABLED=1
VOICE_ALARM_TRIGGER_SECONDS=30
VOICE_ALARM_COOLDOWN_SECONDS=40

# 8. WHATSAPP BRIDGE SERVICE
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
